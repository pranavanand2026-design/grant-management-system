# Local preview. Production must use GRANTFLOW_ENVIRONMENT=production and entra mode.
GRANTFLOW_ENVIRONMENT=development
GRANTFLOW_AUTH_MODE=development

# Browser-facing API address; OAuth providers redirect to <it>/auth/oidc/callback
GRANTFLOW_PUBLIC_API_URL=http://localhost:8000

# "Continue with Google" and "Continue with Microsoft" (optional)
GRANTFLOW_GOOGLE_CLIENT_ID=
GRANTFLOW_GOOGLE_CLIENT_SECRET=
GRANTFLOW_MICROSOFT_CLIENT_ID=
GRANTFLOW_MICROSOFT_CLIENT_SECRET=
# organizations = any Microsoft work account; or a tenant ID for one directory.
GRANTFLOW_MICROSOFT_TENANT=organizations

# Sign-in codes and invitations. Unset in development: printed to the log.
GRANTFLOW_SMTP_HOST=
GRANTFLOW_SMTP_PORT=587
GRANTFLOW_SMTP_USERNAME=
GRANTFLOW_SMTP_PASSWORD=
GRANTFLOW_EMAIL_FROM=GrantFlow <no-reply@example.com>

# Required in production; generated locally in development.
GRANTFLOW_SESSION_SECRET=
GRANTFLOW_ENCRYPTION_KEY=

# Workspace Microsoft Entra application (primary workspace, optional)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_SCOPE=
ENTRA_ADMIN_ROLE=GrantFlow.Administrator
GRANTFLOW_PUBLIC_APP_URL=http://localhost:8000/app/

# Optional dedicated SharePoint application credentials. When omitted, the
# ENTRA_* application above is used for Microsoft Graph.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# SP_SITE_ID may be supplied here or selected from Workspace settings.
SP_SITE_ID=
SP_ROOT_FOLDER=GrantFlow Grant Evidence
